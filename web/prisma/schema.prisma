generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ─────────────────────────────────────────────────────────────
// Better Auth core tables
// Shape matches what the Better Auth Prisma adapter expects —
// String ids, no `password` column on User (credentials live in
// Account instead). See AUTH-MIGRATION.md for what this replaces
// and what it breaks in src/server/routes/*.ts.
// https://www.better-auth.com/docs/adapters/prisma
// ─────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role String @default("student")

  avatar              String  @default("graduate")
  emailAnnouncements  Boolean @default(false)
  emailResources      Boolean @default(false)
  emailImportant      Boolean @default(true)
  platformUpdates     Boolean @default(false)
  platformAlerts      Boolean @default(true)

  sessions Session[]
  accounts Account[]

  openHouseRegistrations OpenHouseRegistration[]
  favoriteSchools        FavoriteSchool[]
  favoritePrograms       FavoriteProgram[]
  favoriteOpenHouses     FavoriteOpenHouse[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Domain models — matched to the field names already used in
// src/server/routes/*.ts so those stubs compile against this
// schema as-is. Only real change vs the JWT-era version on main:
// userId fields are now String to match Better Auth's User.id.
// ─────────────────────────────────────────────────────────────

model School {
  id         String           @id @default(cuid())
  name       String
  shortName  String?
  type       String
  website    String?
  location   String?
  createdAt  DateTime         @default(now())
  openHouses OpenHouse[]
  programs   StudyProgram[]
  favoriteBy FavoriteSchool[]
}

model StudyProgram {
  id            String            @id @default(cuid())
  name          String
  description   String?           @db.Text
  cluster       String
  duration      String?
  levelRequired String?           @db.Text
  tuitionCost   String?
  careers       String?           @db.Text
  createdAt     DateTime          @default(now())
  schoolId      String
  quizResults   QuizResult[]
  school        School            @relation(fields: [schoolId], references: [id])
  favoriteBy    FavoriteProgram[]

  @@index([schoolId])
}

model Question {
  id         String         @id @default(cuid())
  text       String
  textEn     String?
  type       String         @default("single")
  orderIndex Int
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  options    AnswerOption[]
}

model AnswerOption {
  id         String   @id @default(cuid())
  text       String
  textEn     String?
  weights    Json
  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  @@index([questionId])
}

model QuizQuestion {
  id        String       @id @default(cuid())
  text      String
  type      String
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  answers   QuizAnswer[]
}

model QuizAnswer {
  id          String       @id @default(cuid())
  questionId  String
  text        String
  programLink String?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  question    QuizQuestion @relation(fields: [questionId], references: [id])

  @@index([questionId])
}

model Student {
  id          String       @id @default(cuid())
  name        String?
  email       String?      @unique
  schoolYear  String?
  createdAt   DateTime     @default(now())
  quizResults QuizResult[]
}

model QuizResult {
  id                 String       @id @default(cuid())
  createdAt          DateTime     @default(now())
  programId          String
  scores             Json
  studentId          String?
  topCluster         String
  recommendedProgram StudyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  student            Student?     @relation(fields: [studentId], references: [id])

  @@index([programId])
  @@index([studentId])
}

model OpenHouse {
  id                    String                  @id @default(cuid())
  title                 String
  description           String?                 @db.Text
  date                  DateTime
  location              String?
  isOnline              Boolean                 @default(false)
  registrationUrl       String?
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  schoolId              String
  school                School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  OpenHouseRegistration OpenHouseRegistration[]
  favoriteBy            FavoriteOpenHouse[]

  @@index([schoolId])
}

model OpenHouseRegistration {
  id          String    @id @default(cuid())
  userId      String
  openHouseId String
  createdAt   DateTime  @default(now())
  OpenHouse   OpenHouse @relation(fields: [openHouseId], references: [id], onDelete: Cascade)
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, openHouseId])
  @@index([openHouseId])
}

model FavoriteSchool {
  id        String   @id @default(cuid())
  userId    String
  schoolId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
}

model FavoriteProgram {
  id        String       @id @default(cuid())
  userId    String
  programId String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  program   StudyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
}

model FavoriteOpenHouse {
  id          String    @id @default(cuid())
  userId      String
  openHouseId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  openHouse   OpenHouse @relation(fields: [openHouseId], references: [id], onDelete: Cascade)

  @@unique([userId, openHouseId])
}

model AdminSettings {
  id            Int      @id @default(autoincrement())
  language      Json     @default("{\"available\":[\"dutch\",\"english\"],\"default\":\"dutch\"}")
  platform      Json     @default("{\"name\":\"Studiekeuzegids Suriname\",\"contactEmail\":\"\",\"supportEmail\":\"\",\"tagline\":\"\"}")
  features      Json     @default("{\"enableFavorites\":true,\"enableComparison\":true,\"enableQuiz\":true,\"enableOpenHouse\":true}")
  notifications Json     @default("{\"email\":false,\"dailySummary\":false}")
  data          Json     @default("{\"retentionPeriod\":\"90\"}")
  aboutUs       Json     @default("{}")
  updatedAt     DateTime @updatedAt
}

model ProgramComparison {
  id         String   @id @default(cuid())
  programIds Json     // array of 2-3 program IDs compared together
  createdAt  DateTime @default(now())
}

model PageView {
  id        String   @id @default(cuid())
  type      String   // 'visit' | 'favorite'
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}